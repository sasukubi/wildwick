{
  "name": "wildwick",
  "productName": "Wildwick",
  "version": "1.0.0",
  "description": "An online co-op roguelite in a dark magical forest. Keep your flame alive.",
  "author": "sasukubi",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node build/make-icon.js",
    "dist": "node build/make-icon.js && electron-builder --win"
  },
  "build": {
    "appId": "io.github.sasukubi.wildwick",
    "productName": "Wildwick",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Wildwick",
      "artifactName": "Wildwick-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
